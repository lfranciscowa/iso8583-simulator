# ── Servidor TCP (recibe transacciones de cualquier plataforma) ──
SIM_TCP_HOST=0.0.0.0
SIM_TCP_PORT=8583

# ── API HTTP + UI web ──
PORT=4100

# ── Encoding de campos de texto: ascii | ebcdic | auto ──
SIM_ENCODING=auto

# ── Framing del prefijo de longitud sobre TCP ──
SIM_PREFIX_BYTES=2
SIM_PREFIX_ENCODING=binary        # binary | bcd | ascii
SIM_PREFIX_INCLUDES_SELF=false

# ── Latencia simulada (ms). Vacío = aleatoria realista (80–450ms) ──
SIM_LATENCY_MS=

# ── Seguridad ──
# Si SIM_ADMIN_PASS está vacío, el login queda DESHABILITADO (modo abierto).
# Definir ambos para exigir login antes de usar la UI/API.
SIM_ADMIN_USER=admin
SIM_ADMIN_PASS=

# Llave maestra (KEK) para cifrar el llavero (config/keys.json) en reposo.
# Si se omite, se usa una llave de laboratorio fija (NO segura para producción).
# Generar una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIM_MASTER_KEY=
