# ── Servidor TCP (recibe transacciones de cualquier plataforma) ──
SIM_TCP_HOST=0.0.0.0
SIM_TCP_PORT=8583

# ── API HTTP + UI web ──
PORT=4100

# ── Encoding de campos de texto: ascii | ebcdic | auto ──
SIM_ENCODING=auto

# ── Framing del prefijo de longitud sobre TCP ──
SIM_PREFIX_BYTES=2
SIM_PREFIX_ENCODING=binary        # binary | bcd | ascii
SIM_PREFIX_INCLUDES_SELF=false

# ── Latencia simulada (ms). Vacío = aleatoria realista (80–450ms) ──
SIM_LATENCY_MS=

# ── Seguridad / Login de la UI y la API ──
# El login se ACTIVA únicamente si SIM_ADMIN_PASS tiene valor.
# Si SIM_ADMIN_PASS queda vacío, el login está DESHABILITADO (modo abierto,
# útil solo en local). Para exigir login (p. ej. en Render), define ambas.
# En despliegues públicos usa una contraseña fuerte.
SIM_ADMIN_USER=admin
SIM_ADMIN_PASS=

# Llave maestra (KEK) para cifrar el llavero (config/keys.json) en reposo.
# Si se omite, se usa una llave de laboratorio fija (NO segura para producción).
# Generar una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIM_MASTER_KEY=

# Cookies de sesión con flag Secure. En producción (HTTPS) déjalo activado.
# Se activa solo si NODE_ENV=production O SIM_SECURE_COOKIES=true.
NODE_ENV=production
SIM_SECURE_COOKIES=true

# CORS: orígenes cruzados permitidos (lista separada por comas). Vacío = solo
# mismo origen (lo normal: la UI y la API viven en el mismo dominio).
# Ej: SIM_CORS_ORIGINS=https://otra-app.com,https://panel.midominio.com
SIM_CORS_ORIGINS=

# API key del bridge POS (/api/pos-tcp). Si se define, el POS debe enviarla en
# el header x-api-key. Protege la ruta sin exigir login de sesión.
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SIM_BRIDGE_API_KEY=
